{
  "name": "@softwareproduction/introspection-forms",
  "version": "0.2.0",
  "description": "Schema-driven form generation for Vue 3 from GraphQL introspection metadata",
  "author": "Munir Husseini (https://github.com/mhusseini)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhusseini/introspection-forms.git",
    "directory": "packages/introspection-forms"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "import": "./dist/openapi/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./components/*": "./dist/components/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-components.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@graphql-codegen/plugin-helpers": "^5.1.0",
    "openapi-types": "^12.1.3"
  },
  "peerDependencies": {
    "@softwareproduction/dryvjs": "^1.1.0",
    "@softwareproduction/dryvue": "^2.1.0",
    "graphql": "^16.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@softwareproduction/dryvjs": {
      "optional": true
    },
    "@softwareproduction/dryvue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@softwareproduction/dryvjs": "1.1.7",
    "@softwareproduction/dryvue": "2.1.5",
    "@types/node": "^25.9.2",
    "graphql": "^16.9.0",
    "prettier": "^3.8.3",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vue": "^3.5.0"
  }
}
