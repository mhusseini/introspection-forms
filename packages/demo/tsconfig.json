{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": ["vite/client"],
    "paths": {
      "introspection-forms": ["../introspection-forms/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "codegen.config.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
